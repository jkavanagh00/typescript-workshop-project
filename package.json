{
  "name": "express-typescript-docker",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "migrate:latest": "knex --knexfile knexfile.js --require ts-node/register migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js --require ts-node/register migrate:rollback",
    "seed:run": "knex --knexfile knexfile.js --require ts-node/register seed:run",
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "pretty": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.4",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.13",
    "@types/node": "^17.0.21",
    "@typescript-eslint/eslint-plugin": "^5.12.1",
    "@typescript-eslint/parser": "^5.12.1",
    "eslint": "^8.10.0",
    "prettier": "^2.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.5.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint",
      "pre-push": "yarn test"
    }
  },
  "dependencies": {
    "express": "^4.17.3",
    "knex": "^3.2.10",
    "knex-types": "^0.5.0",
    "sqlite3": "^6.0.1",
    "zod": "^4.4.3"
  },
  "imports": {
    "#config/": "./src/config/",
    "#configs/knex-config.js": "./src/config/knex-config.js",
    "#controllers/*": "./src/controllers/*",
    "#models/*": "./src/models/*",
    "#routers": "./src/routers/index.js",
    "#routers/*": "./src/routers/*",
    "#schemas/*": "./src/schemas/*",
    "#utils/*": "./src/utils/*"
  }
}
