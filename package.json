{
  "name": "express-typescript-docker",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "migrate:latest": "node -r ts-node/register ./node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "node -r ts-node/register ./node_modules/knex/bin/cli.js --knexfile knexfile.js migrate:rollback",
    "seed:run": "node -r ts-node/register ./node_modules/knex/bin/cli.js --knexfile knexfile.js seed:run",
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "pretty": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@tsconfig/node16": "^1.0.4",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^17.0.21",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^5.12.1",
    "@typescript-eslint/parser": "^5.12.1",
    "eslint": "^8.10.0",
    "prettier": "^2.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^1.1.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.5.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint",
      "pre-push": "yarn test"
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "express": "^4.17.3",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "knex-types": "^0.5.0",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#config/knex-config": "./src/config/knex-config.ts",
    "#controllers/*": "./src/controllers/*",
    "#models/*": "./src/model/*",
    "#schemas/*": "./src/schemas/*"
  }
}
